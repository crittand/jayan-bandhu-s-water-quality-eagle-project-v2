# copy this to .streamlit/secrets.toml for local testing (that file is git-ignored, never commit it)
# on Streamlit Cloud paste the same thing into: app ⋮ menu -> Settings -> Secrets

# one passcode per organization that's allowed to add data on the Upload Data tab.
# the name on the left is what gets stored with their data + shown on the Monitoring Sites tab.
[upload_passcodes]
"Dry Creek Conservancy" = "change-me-dcc"
# "Auburn Ravine Monitoring Group" = "change-me-auburn"

# optional but needed on Streamlit Cloud: without this, uploads only live until the app restarts.
# token = GitHub fine-grained personal access token, ONLY this repo, permission "Contents: Read and write"
[github]
token = "github_pat_xxxxxxxxxxxxxxxx"
repo = "crittand/jayan-bandhu-s-water-quality-eagle-project-v2"
branch = "main"
# name/email that shows on the upload commits (so it's not your personal github identity). optional
bot_name = "DCC Dashboard Uploads"
bot_email = "dashboard-uploads@noreply.invalid"

